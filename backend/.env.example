# Database Connection URL (Neon PostgreSQL in AWS Singapore: ap-southeast-1)
# Note: In production, always use the Neon pooled connection string (-pooler endpoint)
DATABASE_URL=postgresql://neondb_owner:CHANGE_ME@ep-placeholder-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require

# Application Environment (development | testing | production)
ENVIRONMENT=development

# Application Metadata
APP_NAME="Blackout: Restore the Grid API"
API_V1_PREFIX=/api/v1

# CORS Allowed Origins (Comma-separated)
# In development, permits local frontend previews
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
